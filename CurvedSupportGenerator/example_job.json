{
  "output": "../support_output",
  "clean_output": true,
  "pipeline": {
    "input": {
      "field_mode": "checkpoint",
      "mesh": "../model.obj",
      "normalization_mesh": "../model.obj",
      "checkpoint": "../parameters.pt",
      "layer_values": "../main_scalar_values.txt",
      "skeleton_source": "../saved_skeleton"
    },
    "network": {
      "device": "auto",
      "dim_hidden": 128,
      "num_layers": 5,
      "w0": 71.0,
      "w0_initial": 71.0,
      "batch_size": 32768
    },
    "settings": {
      "envelope_mode": "gradient",
      "trajectory_region": "overhang",
      "support_threshold_angle": 60.0,
      "spacing": 2.0,
      "padding": 10.0,
      "build_direction": [0.0, 1.0, 0.0],
      "layer_spacing": 0.2,
      "all_layers": true,
      "export_envelope_layers": false,
      "export_compatible_layers": true,
      "fast_clearance": true,
      "tip_radius": 2.5,
      "branch_sizing": "bambu",
      "branch_diameter": 2.4,
      "terminal_cap": "rounded",
      "support_field_mode": "relaxed",
      "field_upward_length": 6.0,
      "field_upward_ramp": 4.0,
      "field_platform_upward": true,
      "model_root_foot_radius": 4.0,
      "model_root_foot_shape": "conformal",
      "platform_base_radius_factor": 1.8,
      "platform_base_height": 0.6,
      "layer_trim": "surface_scalar",
      "model_distance_backend": "certified",
      "model_query_backend": "open3d",
      "geometry_threads": 8,
      "layer_workers": 4,
      "geometry_query_batch_size": 8000,
      "trim_pair_pruning": true,
      "allow_stalled_skeleton": true
    }
  }
}
