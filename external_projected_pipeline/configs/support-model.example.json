{
  "height_mode": "3axis",
  "clean_output_dirs": false,
  "log_file": "./outputs/pipeline.log",
  "short_fragment_filter": {
    "enabled": true,
    "min_length": 2.0,
    "min_waypoints": 5,
    "long_jump_threshold": 2.0
  },
  "compatible_inputs": {
    "export_root": "./compatible_export",
    "compatible_export": "compatible_export.json",
    "model_layers": "model_layers",
    "support_layers": "support_layers",
    "model_manifest": "model_layer_manifest.json",
    "support_manifest": "support_layer_manifest.json",
    "sublayer_order": "proximity",
    "material_name": "same_material"
  },
  "paths": {
    "combined_input_surfaces": "./outputs/combined_input_surfaces",
    "remeshed_surfaces": "./outputs/remeshed_surfaces",
    "expanded_support_surfaces": "./outputs/expanded_support_surfaces",
    "toolpaths": "./outputs/toolpaths",
    "heights": "./outputs/heights"
  },
  "remesh": {
    "enabled": false,
    "reuse_existing": false,
    "file_workers": 2,
    "iterations": 6,
    "targetlen_abs": 0.5,
    "targetlen_pct": 0.25,
    "featuredeg": 30.0,
    "adaptive": true,
    "check_surfdist": false,
    "suffix": "",
    "reuse_existing_output": "./outputs/remeshed_surfaces"
  },
  "support_mesh_expand": {
    "enabled": false,
    "reuse_existing": false,
    "offset": 0.0,
    "suffix": "",
    "reuse_existing_output": "./outputs/expanded_support_surfaces"
  },
  "hybrid_contours": {
    "point_reduction": {
      "enabled": true
    },
    "model_half_width_inset": false,
    "reuse_existing_paths": false,
    "planner_backend": "xz_projected_2d",
    "planning_axes": "xz",
    "nozzle_axis": "y",
    "spacing": 0.5,
    "model_lift": 0.0,
    "model_lift_axis": "y",
    "resample_spacing": 0.5,
    "boundary_count": 3,
    "disable_parallel": false,
    "planar_infill": {
      "enabled": false,
      "density": 0.25,
      "solid_density": 1.0,
      "solid_base_main_layers": 4,
      "solid_top_main_layers": 4,
      "angle_degrees": 0.0,
      "alternate_angle_degrees": 90.0,
      "pattern_origin_xz": [
        0.0,
        0.0
      ],
      "overlap": 0.0,
      "max_link_length": 2.1,
      "boundary_link_pitch_factor": 2.0,
      "min_segment_length": 0.25,
      "solid_top_target": "last_main_layers"
    },
    "ironing": {
      "enabled": false,
      "target": "top_classified",
      "main_layer_count": 1,
      "direction": "angle",
      "angle_degrees": 45.0,
      "spacing": 0.25,
      "resample_spacing": 0.25,
      "boundary_inset": 1.5,
      "flow_width": 0.0,
      "clearance_lift": {
        "enabled": false,
        "nozzle_tip_diameter": 0.4,
        "max_lift": 0.08
      }
    },
    "sharp_angle_deg": 60.0,
    "boundary_field_backend": "potpourri_fast_marching_unsigned",
    "parallel_field_backend": "vector_heat_stripe",
    "axis_mode": "auto_tangent_alternating",
    "axis": "x",
    "plane_value": null,
    "level_set_constraint": "None",
    "soft_level_set_weight": -1.0,
    "contour_max_level_fraction": 1.0,
    "min_polyline_points": 2,
    "mild_smooth_all": true,
    "mild_smooth_iterations": 8,
    "mild_smooth_alpha": 0.2,
    "use_vectorized_extractor": true,
    "first_layers_lowest_y_start_count": 0,
    "layer_workers": 2,
    "top_layer_classifier": {
      "enabled": false,
      "output_json": "./outputs/top_layers_report.json",
      "axis": "y",
      "lookahead_main_count": 2,
      "min_uncovered_fraction": 0.3,
      "k_nearest_vertices": 12,
      "sample_mode": "face_centroids",
      "layer_workers": 2,
      "tree_query_workers": 1,
      "global_boundary_mesh": null,
      "global_boundary_distance": 0.6,
      "global_boundary_min_fraction": 0.3,
      "normalize_global_boundary_base_to_zero": true
    },
    "top_layer_overrides": {
      "classification_json": null,
      "boundary_count": 1,
      "parallel_spacing_factor": 1.0,
      "parallel_resample_spacing_factor": 0.9,
      "width_check_enabled": true,
      "width_check_max_factor": 2.0
    },
    "progress_overrides": [],
    "material_overrides": [],
    "hatch_angle_degrees": 0.0,
    "boundary_start_offset_count": 0,
    "parallel_direction_mode": "connect_nearest",
    "projected_width_check": {
      "enabled": false,
      "target": "last_main_layers",
      "main_layer_count": 3,
      "parallel_spacing": 0.42,
      "max_factor": 2.0
    }
  },
  "support_paths": {
    "width": 0.5,
    "resample_spacing": 0.5,
    "min_resample_spacing": 0.08,
    "min_points_per_contour": 16,
    "layer_workers": 2,
    "regular": {
      "contour_count": 2,
      "infill_enabled": true,
      "density": 0.15
    },
    "platform": {
      "contour_count": 3,
      "infill_wall_overlap": 0.05
    },
    "contact": {
      "contour_count": 2,
      "reduce_contour_for_infill": true,
      "density": 0.5,
      "flow_ratio": 1.0,
      "infill_wall_overlap": 0.05,
      "min_fill_area": 5.0,
      "angle_degrees": 0.0,
      "alternate_angle_degrees": 90.0
    },
    "hole_repair": {
      "enabled": false,
      "field_source": null
    },
    "backing_repair": {
      "enabled": false
    }
  },
  "heights_3axis": {
    "backend": "nearest_triangle",
    "axis": "y",
    "platform_value": 0.0,
    "previous_main_window": 2,
    "max_height": null,
    "nearest_direct_height": null,
    "layer_workers": 2,
    "contact_support_height": {
      "enabled": true,
      "direction_mode": "model_normal",
      "gap": 0.2,
      "gap_metadata_field": null,
      "max_query_distance": 2.0
    },
    "adaptive_point_decimation": {
      "enabled": false
    },
    "nominal_layer_height": 0.2,
    "platform_height_factor": 1.5,
    "nearest_direct_factor": 1.5,
    "support_validation": {
      "enabled": true,
      "check_height_factor": 1.75,
      "max_bead_height_factor": 1.5,
      "model_solid": null,
      "normal_miss_tolerance_degrees": 3.0,
      "height_outlier_policy": "clamp_warn"
    }
  },
  "pipeline_variant": "support-model",
  "logs_dir": "./outputs/logs",
  "execution": {
    "blas_threads_per_process": 1,
    "keep_patch_artifacts": false
  }
}
